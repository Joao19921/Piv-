  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "4.17.21",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "pnpm": "^12.3.4",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "pnpm": {
    "patchedDependencies": {
      "wouter@3.7.1": "patches/wouter@3.7.1.patch"
    },
    "overrides": {
      "tailwindcss>nanoid": "3.3.7"
    },
    "auditConfig": {
      "_comment": "Passivo conhecido de `pnpm audit --prod --audit-level high`, que e o gate do CI (job 'security' em .github/workflows/ci.yml). Cada entrada precisa de motivo e caminho de saida; a lista deve encolher, nunca crescer sem justificativa no PR. Vulnerabilidade high/critical nova em dependencia de producao quebra o build de proposito.",
      "_GHSA-37ch-88jc-xwx2": "path-to-regexp (ReDoS) via express@4.21.2. Sem correcao na linha 4.x -- so o express 5 traz o path-to-regexp corrigido. Exploracao exige rota com padrao dinamico controlado pelo atacante; todas as rotas do Pivo sao estaticas. Saida: migrar para express 5.",
      "ignoreGhsas": [
        "GHSA-37ch-88jc-xwx2"
      ]
    }
  }
}