NODE_ENV=production
PORT=3000

# Habilita Basic Auth no ambiente publicado quando ambos estiverem preenchidos.
TEST_ACCESS_USER=pivo-teste
TEST_ACCESS_PASSWORD=troque-esta-senha

# Opcional: conector externo para benchmark salarial ao vivo.
MARKET_BENCHMARK_CONNECTOR_URL=

# Opcional: DSN do Sentry (sentry.io > Settings > Projects > <projeto> > Client Keys (DSN)).
# Sem essa variavel, logger.error() so escreve no stdout (comportamento anterior) — o app
# nunca depende do Sentry para funcionar.
SENTRY_DSN=

# Postgres (Supabase). Sem esta variavel, o app roda 100% com os snapshots estaticos
# embutidos no codigo (comportamento anterior).
#
# IMPORTANTE: use o "Connection pooler" (Supavisor), NAO o "Direct connection" —
# o host direto (db.SEU-PROJETO.supabase.co) so resolve em IPv6, e Render/Lambda/a
# maioria dos PaaS so tem saida IPv4 (a conexao falha com "getaddrinfo ENOTFOUND").
# Pegue em Supabase > Project Settings > Database > Connection string (host
# "aws-0-<regiao>.pooler.supabase.com", usuario "postgres.SEU-PROJETO") — a PORTA muda
# conforme onde vai rodar:
#   - Render/local (processo unico, pool de conexao de vida longa): porta 5432 ("Session").
#   - Lambda (server/scripts/refreshSources.ts, uma invocacao por vez): porta 6543 ("Transaction").
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-SUA-REGIAO.pooler.supabase.com:5432/postgres

# As variaveis abaixo NAO sao usadas pelo app web (Render) — ele so le precos de AWS/GCP
# do Postgres, atualizado pela Lambda "pivo-refresh-sources" (IAM Role, sem access key fixa).
# Sao uteis apenas para rodar a ingestao manualmente em dev (`pnpm run refresh-sources`):
#
# - AWS: nao precisa de env var aqui. O SDK usa a cadeia padrao de credenciais — se voce ja
#   rodou `aws configure`/`aws sso login` nesta maquina, a ingestao local usa essa mesma sessao.
# - GCP: API key do Google Cloud Console restrita a "Cloud Billing API".
GOOGLE_CLOUD_BILLING_API_KEY=
