# Copie para .env e preencha localmente. Nunca commitar valores reais.

BENCHMARK_WORKER_ENV=local
BENCHMARK_WORKER_LOG_LEVEL=INFO

# manual | scheduled -- ver "Estrategia de execucao" em
# docs/FASE-2-ARQUITETURA-BENCHMARK-WORKER.md
BENCHMARK_WORKER_RUN_MODE=manual

# Isolamento de falha por fonte
BENCHMARK_WORKER_SOURCE_TIMEOUT_SECONDS=30
BENCHMARK_WORKER_SOURCE_MAX_RETRIES=2
BENCHMARK_WORKER_SOURCE_RETRY_BACKOFF_SECONDS=5

# Persistencia (Supabase/Postgres) -- usada somente a partir da Fase 3
# BENCHMARK_WORKER_DATABASE_URL=

# Credenciais por fonte -- somente apos autorizacao documentada (ver
# docs/FASE-1-CONFORMIDADE-BENCHMARK-WORKER.md). Nao preencher sem essa autorizacao.
# INDEED_API_KEY=
# GLASSDOOR_API_KEY=
# INFOJOBS_API_KEY=
