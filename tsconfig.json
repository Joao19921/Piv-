{
  "include": ["client/src/**/*", "shared/**/*", "server/**/*"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    // Sem "target" explicito o tsc assume ES5 e reprova sintaxe moderna que o projeto ja usa
    // (iterar um Map, regex com \p{...} e flag u), mesmo com "lib": ["esnext"] e o codigo
    // rodando em Node 22 / navegadores atuais. ES2022 alinha a checagem ao que de fato executa.
    "target": "ES2022",
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    // Sem "baseUrl": o TypeScript 7 removeu a opcao, e o bump para 7.0.2 quebrou o build por
    // causa dela. Os caminhos abaixo continuam funcionando: sem baseUrl, `paths` e resolvido
    // relativo a ESTE arquivo, que e exatamente o que "./client/src/*" ja significava.
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"]
    }
  }
}
